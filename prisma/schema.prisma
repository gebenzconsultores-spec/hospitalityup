generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Propiedad {
  id               String                  @id @default(cuid())
  nombre           String
  nombreEn         String?
  tipo             String
  ubicacion        String
  region           String
  logo             String?
  plan             String                  @default("boutique")
  moneda           String                  @default("USD")
  activo           Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  password         String                  @default("empresa123")
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  empresaId        String?
  alertas          AlertaRiesgo[]
  candidatos       CandidatoPool[]
  capacitaciones   Capacitacion[]
  empleados        Empleado[]
  Empresa          Empresa?                @relation(fields: [empresaId], references: [id])
  servicios        Servicio[]
  solicitudesCap   SolicitudCapacitacion[]
  SolicitudPedido  SolicitudPedido[]
  Vacante          Vacante[]
  ventasNps        VentaNPS[]
}

model Empleado {
  id                     String                 @id @default(cuid())
  empleadoId             String                 @unique
  nombre                 String
  posicion               String
  posicionEn             String?
  departamento           String
  departamentoEn         String?
  foto                   String?
  fechaIngreso           DateTime
  estado                 String                 @default("activo")
  nivelCarrera           Int                    @default(1)
  rutaCarrera            String?
  rutaCarreraEn          String?
  puntuacionConocimiento Float                  @default(0)
  puntuacionVentas       Float                  @default(0)
  puntuacionHospitalidad Float                  @default(0)
  puntuacionTotal        Float                  @default(0)
  totalUpselling         Float                  @default(0)
  npsPromedio            Float                  @default(0)
  cursosCompletados      Int                    @default(0)
  cursosEnProgreso       Int                    @default(0)
  indiceFelicidad        Float                  @default(80)
  riesgoBaja             Float                  @default(0)
  nivelRiesgoBaja        String                 @default("bajo")
  justificacionRiesgo    String?
  sugerenciaCapacitacion String?
  ultimaActividad        DateTime?
  fechaBaja              DateTime?
  reemplazoTargetId      String?
  propiedadId            String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  password               String                 @default("1234")
  cubreTurnos            Boolean                @default(false)
  diasTrabajo            String?
  fechaFinContrato       DateTime?
  horarioEntrada         String?
  horarioSalida          String?
  salario                Float?
  tipoContrato           String?
  tipoJornada            String                 @default("fijo")
  turnoPreferido         String?
  alertas                AlertaRiesgo[]
  propiedad              Propiedad              @relation(fields: [propiedadId], references: [id])
  cursos                 EmpleadoCapacitacion[]
  respuestasNps          RespuestaNPS[]
  ventas                 VentaNPS[]
}

model Capacitacion {
  id            String                  @id @default(cuid())
  titulo        String
  tituloEn      String?
  descripcion   String
  descripcionEn String?
  categoria     String
  categoriaEn   String?
  modalidad     String
  duracion      Int
  dificultad    String                  @default("principiante")
  dificultadEn  String?
  urlContenido  String?
  miniatura     String?
  posicion      String?
  posicionEn    String?
  puntos        Int                     @default(10)
  activo        Boolean                 @default(true)
  propiedadId   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  propiedad     Propiedad?              @relation(fields: [propiedadId], references: [id])
  inscripciones EmpleadoCapacitacion[]
  solicitudes   SolicitudCapacitacion[]
}

model EmpleadoCapacitacion {
  id              String       @id @default(cuid())
  empleadoId      String
  capacitacionId  String
  estado          String       @default("no_iniciado")
  progreso        Float        @default(0)
  puntuacion      Float?
  fechaInicio     DateTime?
  fechaCompletado DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  capacitacion    Capacitacion @relation(fields: [capacitacionId], references: [id])
  empleado        Empleado     @relation(fields: [empleadoId], references: [id])
}

model VentaNPS {
  id                String    @id @default(cuid())
  empleadoId        String
  propiedadId       String
  montoUpselling    Float     @default(0)
  esUpselling       Boolean   @default(false)
  nombreServicio    String?
  cantidad          Int       @default(1)
  precioUnitario    Float
  montoTotal        Float
  calificacionNPS   Int?
  esPromotor        Boolean?
  comentario        String?
  fuenteNPS         String?
  categoriaServicio String?
  fechaVenta        DateTime  @default(now())
  analizadoPorIA    Boolean   @default(false)
  resultadoIA       String?
  createdAt         DateTime  @default(now())
  empleado          Empleado  @relation(fields: [empleadoId], references: [id])
  propiedad         Propiedad @relation(fields: [propiedadId], references: [id])
}

model RespuestaNPS {
  id         String   @id @default(cuid())
  empleadoId String
  puntuacion Int
  comentario String?
  esPromotor Boolean
  fuente     String   @default("qr")
  createdAt  DateTime @default(now())
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
}

model AlertaRiesgo {
  id            String     @id @default(cuid())
  empleadoId    String
  propiedadId   String?
  tipo          String
  tipoEn        String?
  severidad     String     @default("medio")
  mensaje       String
  mensajeEn     String?
  probabilidad  Float
  generadoPorIA Boolean    @default(false)
  leida         Boolean    @default(false)
  resuelta      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  empleado      Empleado   @relation(fields: [empleadoId], references: [id])
  propiedad     Propiedad? @relation(fields: [propiedadId], references: [id])
}

model CandidatoPool {
  id                   String     @id @default(cuid())
  nombre               String
  email                String?
  telefono             String?
  posicion             String
  posicionEn           String?
  region               String
  experiencia          Int        @default(0)
  habilidades          String?
  estado               String     @default("disponible")
  puntuacionEntrevista Float?
  notas                String?
  fuente               String     @default("referido")
  propiedadId          String?
  empleadoReemplazaId  String?
  fechaContratacion    DateTime?
  onboardingCompletado Boolean    @default(false)
  nivelAlcanzado       Float      @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  propiedad            Propiedad? @relation(fields: [propiedadId], references: [id])
}

model SolicitudCapacitacion {
  id               String        @id @default(cuid())
  propiedadId      String
  capacitacionId   String?
  modalidad        String
  tema             String?
  fechaSolicitada  DateTime
  fechaConfirmada  DateTime?
  participantes    Int           @default(1)
  instructorId     String?
  nombreInstructor String?
  estado           String        @default("pendiente")
  costo            Float?
  notas            String?
  creadoPor        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  linkZoom         String?
  capacitacion     Capacitacion? @relation(fields: [capacitacionId], references: [id])
  propiedad        Propiedad     @relation(fields: [propiedadId], references: [id])
}

model Instructor {
  id           String   @id @default(cuid())
  nombre       String
  especialidad String
  ubicacion    String
  region       String
  calificacion Float    @default(0)
  tarifaHora   Float
  disponible   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notificacion {
  id          String   @id @default(cuid())
  tipo        String
  titulo      String
  tituloEn    String?
  mensaje     String
  mensajeEn   String?
  leida       Boolean  @default(false)
  accionUrl   String?
  propiedadId String?
  prioridad   String   @default("normal")
  createdAt   DateTime @default(now())
}

model Servicio {
  id                  String    @id @default(cuid())
  propiedadId         String
  nombre              String
  nombreEn            String?
  descripcion         String?
  descripcionEn       String?
  categoria           String
  categoriaEn         String?
  esUpselling         Boolean   @default(false)
  precioNormal        Float
  precioUpselling     Float?
  objetivoUpselling   String?
  objetivoUpsellingEn String?
  imagen              String?
  disponible          Boolean   @default(true)
  orden               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  propiedad           Propiedad @relation(fields: [propiedadId], references: [id])
}

model LogAgenteIA {
  id              String   @id @default(cuid())
  tipo            String
  empleadoId      String?
  ventaId         String?
  inputPayload    String?
  outputResultado String?
  nivelRiesgo     String?
  procesado       Boolean  @default(true)
  error           String?
  createdAt       DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Empresa {
  id               String      @id
  nombre           String
  nombreEn         String?
  tipo             String      @default("grupo_restaurantero")
  rfc              String?
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  plan             String      @default("boutique")
  maxPropiedades   Int         @default(1)
  password         String      @default("empresa123")
  activo           Boolean     @default(true)
  logo             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  Propiedad        Propiedad[]
  Proveedor        Proveedor[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductoProveedor {
  id              String            @id
  proveedorId     String
  nombre          String
  nombreEn        String?
  descripcion     String?
  descripcionEn   String?
  categoria       String            @default("otro")
  categoriaEn     String?
  unidad          String?
  precio          Float
  precioMayoreo   Float?
  cantidadMinima  Int               @default(1)
  imagen          String?
  disponible      Boolean           @default(true)
  propiedadesIds  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Proveedor       Proveedor         @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  SolicitudPedido SolicitudPedido[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Proveedor {
  id                String              @id
  nombre            String
  nombreEn          String?
  tipo              String              @default("otro")
  rfc               String?
  contactoNombre    String?
  contactoEmail     String?
  contactoTelefono  String?
  direccion         String?
  region            String?
  ciudad            String?
  paginaWeb         String?
  logo              String?
  activo            Boolean             @default(true)
  calificacion      Float               @default(0)
  notas             String?
  empresaId         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  ProductoProveedor ProductoProveedor[]
  Empresa           Empresa?            @relation(fields: [empresaId], references: [id])
  SolicitudPedido   SolicitudPedido[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SolicitudPedido {
  id                 String             @id
  propiedadId        String
  solicitadoPor      String?
  proveedorId        String
  productoId         String?
  cantidad           Int                @default(1)
  unidad             String?
  precioEstimado     Float?
  totalEstimado      Float?
  notas              String?
  estado             String             @default("pendiente")
  fechaSolicitud     DateTime           @default(now())
  fechaRespuesta     DateTime?
  fechaEntrega       DateTime?
  respuestaProveedor String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  ProductoProveedor  ProductoProveedor? @relation(fields: [productoId], references: [id])
  Propiedad          Propiedad          @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  Proveedor          Proveedor          @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Vacante {
  id                  String    @id
  propiedadId         String
  posicion            String
  departamento        String?
  descripcion         String?
  tipoContrato        String?
  tipoJornada         String?
  horario             String?
  salario             Float?
  region              String?
  estado              String    @default("abierta")
  prioridad           String    @default("normal")
  fechaApertura       DateTime  @default(now())
  fechaCierre         DateTime?
  esReemplazo         Boolean   @default(false)
  empleadoReemplazaId String?
  candidatosAsignados String?
  notas               String?
  creadoPor           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  Propiedad           Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
}
